# === Required ===
# Authentication
NEXTAUTH_SECRET=          # Random string for NextAuth session encryption (generate with: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:5000

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/orplex
# Direct (non-pooled) connection for `prisma migrate deploy` — migrations use
# advisory locks that fail on transaction poolers. Serverless: Supabase
# Dashboard → Connect → Direct connection (port 5432). Local dev: same as above.
DIRECT_URL=postgresql://user:password@localhost:5432/orplex

# === AI Provider Keys (at least one required) ===
OPENAI_API_KEY=           # OpenAI API key
ANTHROPIC_API_KEY=        # Anthropic API key
OPENROUTER_API_KEY=       # OpenRouter API key (access to multiple models)
NVIDIA_API_KEY=           # NVIDIA NIM API key (default provider)
GROQ_API_KEY=             # Groq API key (fast lane)
AI_PROVIDER=nvidia        # Default provider: nvidia | openrouter | groq | custom

# === Optional ===
# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:5000  # Public URL for API callbacks
PORT=5000                                  # Server port (default: 5000)

# Security
ALLOWED_ORIGINS=http://localhost:5000       # Comma-separated allowed CORS origins
# Comma-separated user ids allowed on /api/admin/*. REQUIRED in production:
# when unset, every /api/admin/* route fails closed with 403 (dev stays open).
ADMIN_USER_IDS=
# 64-hex key for AES-256-GCM BYOK/MCP encryption. REQUIRED in production.
# Generate with: openssl rand -hex 32
ENCRYPTION_SECRET=
# OAuth (optional — enable providers by setting both)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Local MCP gateway binding (REQUIRED on multi-user hosts, see mcp-gateway.ts)
ORPLEX_MCP_TOKEN=
ORPLEX_MCP_USER_ID=
# Sync hub shared secret (required for /api/sync/*)
ORPLEX_SYNC_HUB_SECRET=
# Kill switch for hosted deployments reachable by untrusted users
AGENT_EXEC_DISABLED=
# Vercel Cron auth (REQUIRED on Vercel — set the same value in dashboard)
CRON_SECRET=
# Minimum desktop app version the backend serves (unset = allow all)
MIN_SUPPORTED_APP_VERSION=

# === Split deployment (frontend and API on different origins) ===
# Leave everything below unset for the default same-origin (desktop/local) mode.
# NEXT_PUBLIC_API_BASE_URL=https://api.example.com   # Baked into the FRONTEND build — all client calls go here
# AUTH_COOKIE_DOMAIN=.example.com                    # Shared cookie domain: app.example.com + api.example.com
# AUTH_COOKIE_SAMESITE=None                          # Only for UNRELATED domains; requires HTTPS on both

# E2B Cloud Sandbox (optional — enables sandboxed command execution)
E2B_API_KEY=

# Email (for notifications/magic links)
EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
EMAIL_FROM=noreply@example.com

# Sentry (error tracking — optional)
SENTRY_DSN=
# Bugsink/Sentry browser DSN (NEXT_PUBLIC_ variant is baked into the client bundle)
NEXT_PUBLIC_BUGSINK_DSN=
BUGSINK_DSN=

# Logging
LOG_LEVEL=info              # debug | info | warn | error

# === Vercel / cloud only (set in dashboard, NOT in local .env) ===
# NEXTAUTH_URL=https://your-app.vercel.app   # Must be the production URL on Vercel
# NEXT_PUBLIC_API_BASE_URL=https://your-app.vercel.app  # Baked into desktop builds
# ORPLEX_API_URL=https://your-app.vercel.app  # Server-side backend origin
# MIN_SUPPORTED_APP_VERSION=1.0.1  # Floor for desktop clients (426 handshake)

# === One-time setup ===
# Secrets live in ONE place: the Vercel dashboard (the vault).
#
# First time on a machine (one command, one time):
#   vercel login && vercel link          # once per clone
#   npm run setup -- --pull=production   # downloads vault → .env (backs up first)
#
# Local-only alternative (no Vercel):  npm run setup
#   - creates .env from this file (never overwrites existing values)
#   - generates NEXTAUTH_SECRET, ENCRYPTION_SECRET, CRON_SECRET,
#     ORPLEX_MCP_TOKEN, ORPLEX_SYNC_HUB_SECRET automatically
# Push local → vault:  npm run setup -- --vercel   (never overwrites, skips existing)
# Verify:  npm run env:check   (used by CI)
