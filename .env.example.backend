# =============================================================================
# Orplex BACKEND — environment template (API-only deployment)
# Copy to .env (or your host's env editor) and fill in every value.
# The frontend counterpart is ONE build var: NEXT_PUBLIC_API_BASE_URL.
# =============================================================================

# --- Core -------------------------------------------------------------------
# Postgres connection (Neon/Supabase/Railway Postgres/local embedded).
DATABASE_URL=postgresql://user:password@host:5432/orplex

# Auth (NextAuth). NEXTAUTH_URL is the BACKEND's public origin.
NEXTAUTH_URL=https://api.your-domain.com
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# CORS allowlist: the FRONTEND origin(s) allowed to call this API.
# Exact scheme+host match, comma-separated. Cookies make "*" impossible.
ALLOWED_ORIGINS=https://app.your-domain.com

# Cookie sharing: same parent domain as the frontend so one sign-in covers
# both (app.your-domain.com + api.your-domain.com → .your-domain.com).
# Unrelated domains instead: AUTH_COOKIE_SAMESITE=None (HTTPS required).
AUTH_COOKIE_DOMAIN=.your-domain.com

# --- Backend-only mode -------------------------------------------------------
# Pages return a JSON api-only stub; only /api/* is served. REQUIRED=1.
BACKEND_ONLY=1

# --- OAuth providers (sign-in buttons) --------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- AI providers (server-side keys — never exposed to the browser) ---------
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
GROQ_API_KEY=
GROQ_MODEL=

# --- Agent executor / limits -------------------------------------------------
# The backend runs agent runs + tool execution; keep at least 1 concurrent slot.
ORPLEX_SERVER_EXECUTOR=1
ORPLEX_MAX_CONCURRENT_RUNS=2
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=200

# --- Optional integrations ---------------------------------------------------
# Bug reports land in this inbox (Gmail app password, not the account password).
BUG_REPORT_RECIPIENT=
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Supabase-hosted auth JWT verification (only if you use Supabase tokens).
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
