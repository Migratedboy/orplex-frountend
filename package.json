{
  "name": "orplex-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Orplex backend: API-only Next.js app owning every route handler, next-auth, Prisma and all processing. The frontend (repo root) renders UI only.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:hosted": "next dev -H 0.0.0.0 -p ${PORT:-5010}",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "test": "jest --forceExit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:local": "node ../scripts/local-db.mjs start"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.22.0",
    "jszip": "^3.10.1",
    "next": "^16.3.3",
    "next-auth": "^4.24.0",
    "nodemailer": "7.0.13",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "jest": "^30.5.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0"
  }
}
