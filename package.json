{
  "name": "orplex-code",
  "version": "3.0.4",
  "private": true,
  "description": "Orplex Code — the AI coding agent for your desktop and cloud.",
  "author": {
    "name": "orplex.techlimited"
  },
  "copyright": "Copyright © 2026 orplex.techlimited",
  "main": "electron-dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs && npm run electron:build:main",
    "dev": "node scripts/dev-branded-electron.mjs",
    "dev:ui": "next dev -p 5000",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "node scripts/assert-no-dev-server.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "npm run electron:build:main && electron .",
    "electron:dev": "npm run dev",
    "electron:start": "npm run start",
    "electron:build:main": "tsc -p electron/tsconfig.json && npx terser electron-dist/main.js -o electron-dist/main.js --compress --mangle && node scripts/prepare-electron-deps.mjs",
    "electron:dist": "npm run build && npm run electron:build:main && npm run electron:stage && npm run electron:package",
    "lint": "eslint . && node scripts/check-placeholders.mjs",
    "audit": "node scripts/audit-wiring.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "audit:events": "node scripts/audit-events.mjs",
    "audit:mcp": "node scripts/audit-mcp-catalog.mjs",
    "postinstall": "prisma generate && node scripts/fetch-pgdump.mjs",
    "test": "jest --forceExit",
    "test:e2e": "playwright test",
    "eval:reliability": "node evals/reliability/run.mjs",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "check:fonts": "node scripts/check-fonts-sync.mjs",
    "db:pgdump": "node scripts/fetch-pgdump.mjs",
    "db:restore-drill": "node scripts/restore-drill.mjs",
    "bench:report": "node scripts/bench-report.mjs",
    "clean": "node scripts/clean.mjs",
    "setup": "node scripts/setup-env.mjs",
    "env:check": "node scripts/setup-env.mjs --check",
    "electron:stage": "node scripts/stage-desktop-package.mjs",
    "electron:package": "electron-builder --projectDir .desktop-package"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/client": "2.4.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@orplex/sdk": "^0.5.0",
    "@prisma/client": "^5.20.0",
    "@vercel/sandbox": "^3.9.0",
    "electron-updater": "^6.8.11",
    "framer-motion": "^13.4.0",
    "jose": "^5.10.0",
    "jszip": "^3.10.1",
    "motion": "^13.5.1",
    "next": "^16.4.6",
    "next-auth": "^4.24.0",
    "nodemailer": "^7.0.13",
    "pino": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.6.2",
    "builder-util-runtime": "^9.7.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.6",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.2",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "dompurify": "^3.4.14",
    "@next/eslint-plugin-next": {
      "glob": "^10.5.0"
    },
    "postcss": "$postcss"
  },
  "build": {
    "appId": "tech.orplex.app",
    "productName": "Orplex Code",
    "asar": true,
    "asarUnpack": [
      ".next/standalone/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Migratedboy",
      "repo": "orplex-releases"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**/*",
      "electron/app-config.json",
      "electron/assets/icon.ico",
      "electron/assets/icon.png",
      "electron/assets/icon32.png",
      "electron/assets/tray.png",
      "electron/assets/icon.icns",
      ".next/standalone/**/*",
      "!.next/standalone/.localpg/**/*",
      "!node_modules/**/*",
      "package.json",
      "!**/.env",
      "!**/.env.*",
      "!.next/standalone/release/**/*",
      "!.next/standalone/node_modules/electron/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "electron/assets/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "electron/assets/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico",
      "artifactName": "Orplex-Code-Setup-${version}.${ext}"
    },
    "nsis": {
      "include": "electron/nsis/installer.nsh"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/icon.icns",
      "category": "public.app.developer-tools",
      "artifactName": "Orplex-Code-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/icon.png",
      "artifactName": "Orplex-Code-${version}.${ext}"
    },
    "electronVersion": "41.7.1"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "e2b": "^2.64.0"
  }
}
