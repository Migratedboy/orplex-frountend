{
  "name": "orplex-code",
  "version": "1.0.0",
  "private": true,
  "main": "electron-dist/main.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/fetch-fonts.mjs && npm run electron:build:main",
    "dev": "electron .",
    "dev:ui": "next dev -p 5000",
    "prebuild": "node scripts/fetch-fonts.mjs",
    "build": "next build",
    "start": "npm run electron:build:main && electron .",
    "electron:dev": "npm run dev",
    "electron:start": "npm run start",
    "electron:build:main": "tsc -p electron/tsconfig.json",
    "electron:dist": "npm run build && npm run electron:build:main && electron-builder",
    "lint": "eslint .",
    "audit": "node scripts/audit-wiring.mjs",
    "postinstall": "node scripts/fetch-pgdump.mjs",
    "test": "jest --forceExit",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json --noEmit",
    "check:fonts": "node scripts/check-fonts-sync.mjs",
    "db:local": "node scripts/local-db.mjs start",
    "db:pgdump": "node scripts/fetch-pgdump.mjs",
    "db:restore-drill": "node scripts/restore-drill.mjs",
    "db:local:stop": "node scripts/local-db.mjs stop",
    "bench:report": "node scripts/bench-report.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@modelcontextprotocol/client": "2.3.0",
    "@prisma/client": "^5.20.0",
    "clsx": "^2.1.0",
    "jszip": "^3.10.1",
    "motion": "^13.4.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.0",
    "pino": "^10.3.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-error-boundary": "^6.1.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.3",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.3",
    "jest": "^30.5.0",
    "playwright": "^1.62.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.0",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "dompurify": "^3.4.14",
    "@next/eslint-plugin-next": {
      "glob": "^10.5.0"
    },
    "postcss": "$postcss"
  },
  "build": {
    "appId": "tech.orplex.app",
    "productName": "Orplex Code",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron-dist/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/next/dist",
        "to": "app/node_modules/next/dist"
      },
      {
        "from": "node_modules/next/package.json",
        "to": "app/node_modules/next/package.json"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
