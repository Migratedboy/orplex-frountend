// Prisma schema for Supabase (PostgreSQL)
// Run: npx prisma db push (after setting DATABASE_URL in .env)
// Or:  npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // NOTE: no directUrl — env("DIRECT_URL") hard-fails validate/generate/runtime
  // whenever the var is unset (P1012), and .env edits are out of bounds.
  // Hosted migration (backend mirror) adds directUrl + supplies DIRECT_URL
  // inline at that time. Tracked as C4 in docs/MCP-OAUTH.md.
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String?           @unique
  emailVerified    DateTime?
  image            String?
  accounts         Account[]
  sessions         Session[]
  conversations    Conversation[]
  tasks            Task[]
  agentRuns        AgentRun[]
  workspaceMembers WorkspaceMember[]
  // Last workspace folder registered via the File System Access API.
  // Durable copy of the in-memory registry (workspace-cwd.ts) so runs and
  // merges survive a server restart.
  workspacePath    String?
  mcpServers       McpServerConfig[]
  mcpConnections   McpConnection[]
  mcpOAuthPendings McpOAuthPending[]
  mcpTools         McpTool[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New Chat")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  // Workspace folder this thread was created in (folder NAME, e.g. "orplex").
  // Groups threads under their project in the sidebar; null = Ungrouped.
  // Name (not path) on purpose: paths are device-specific, names group fine.
  workspaceName String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, workspaceName])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String       @db.Text
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt      String    @db.Text
  mode        String    @default("ask") // "ask" | "plan" | "code"
  status      String    @default("pending") // "pending" | "running" | "completed" | "failed"
  result      String?   @db.Text
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  toolCalls ToolCall[]

  @@map("tasks")
}

model ToolCall {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tool      String
  args      String   @db.Text
  result    String?  @db.Text
  status    String   @default("pending") // "pending" | "running" | "success" | "error"
  duration  Int? // milliseconds
  createdAt DateTime @default(now())

  @@map("tool_calls")
}

model AgentRun {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompt          String    @db.Text
  status          String    @default("pending") // "pending" | "spec" | "tests" | "implement" | "verify" | "done" | "failed"
  workspace       String    @db.Text
  executionTarget String    @default("server")
  autonomyPolicy  String    @default("approval")
  idempotencyKey  String?   @unique
  specResult      Json?
  testsResult     Json?
  patchesResult   Json?
  verifyResult    Json?
  result          Json?
  priority        Int       @default(0) // higher = claimed first; queued runs only
  // BYOK frontier mode: per-run model choice; empty = provider env default.
  modelOverride   String?
  // Morning-PR-queue scheduling: claim paths skip runs whose time hasn't come.
  notBefore       DateTime?
  // Missions: a parent run groups its child runs (swarm/blueprint planners
  // emit the subtasks). Null = a normal standalone run.
  parentRunId     String?
  missionLabel    String?
  retries         Int       @default(0)
  tokenUsage      Int       @default(0)
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  steps     PipelineStep[]
  tasks     AgentTask[]
  events    RunEvent[]
  artifacts AgentArtifact[]
  approvals ApprovalRequest[]
  checkpoints RunCheckpoint[]
  // Rows truncated by a checkpoint restore go here (never destroyed).
  archived  Json?

  @@map("agent_runs")
}

model PipelineStep {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  state     String
  input     String   @db.Text
  output    String   @db.Text
  duration  Int      @default(0)
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("pipeline_steps")
}

model AgentTask {
  id          String    @id @default(cuid())
  runId       String
  run         AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  role        String
  title       String
  status      String    @default("pending")
  input       Json
  output      Json?
  attempt     Int       @default(0)
  leaseOwner  String?
  leaseUntil  DateTime?
  error       String?   @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dependencies AgentTaskDependency[] @relation("TaskDependencies")
  dependents   AgentTaskDependency[] @relation("TaskDependents")
  artifacts    AgentArtifact[]
  events       RunEvent[]

  @@index([runId, status])
  @@index([leaseUntil])
  @@map("agent_tasks")
}

model AgentTaskDependency {
  taskId      String
  dependsOnId String
  task        AgentTask @relation("TaskDependencies", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn   AgentTask @relation("TaskDependents", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnId])
  @@map("agent_task_dependencies")
}

model RunEvent {
  id        String     @id @default(cuid())
  runId     String
  run       AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId    String?
  task      AgentTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sequence  Int
  type      String
  payload   Json
  createdAt DateTime   @default(now())

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@map("run_events")
}

model AgentArtifact {
  id        String     @id @default(cuid())
  runId     String
  run       AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  taskId    String?
  task      AgentTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      String
  name      String
  mediaType String
  content   String     @db.Text
  createdAt DateTime   @default(now())
  comments  Comment[]

  // Review workflow (Antigravity-style chain): position in the run's
  // plan → diff → screenshot → walkthrough chain, plus the human verdict.
  sequence  Int?
  status    String?    // draft | reviewed | approved | rejected
  reviewNote String?

  @@index([runId, kind])
  @@index([runId, sequence])
  @@map("agent_artifacts")
}

model RunCheckpoint {
  id        String   @id @default(cuid())
  runId     String
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  sequence  Int
  kind      String   // git | snapshot
  ref       String   // git ref or snapshot dir
  label     String
  filesCount Int     @default(0)
  createdAt DateTime @default(now())

  @@unique([runId, sequence])
  @@index([runId, createdAt])
  @@map("run_checkpoints")
}

model ApprovalRequest {
  id        String    @id @default(cuid())
  runId     String
  run       AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  action    String
  payload   Json
  status    String    @default("pending")
  decidedBy String?
  decidedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@index([runId, status])
  @@map("approval_requests")
}

// === Knowledge Base Models ===

model Learning {
  id          String   @id @default(cuid())
  projectId   String   @default("default")
  pattern     String // Short label: "auth-flow", "api-error-handling"
  content     String   @db.Text // The actual learning text
  tags        String[] // Searchable tags for retrieval
  sourceRunId String? // Which agent run produced this learning
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, tags])
  @@map("learnings")
}

model Comment {
  id         String        @id @default(cuid())
  artifactId String
  artifact   AgentArtifact @relation(fields: [artifactId], references: [id], onDelete: Cascade)
  userId     String
  content    String        @db.Text
  // Pinned visual annotation position on a screenshot artifact (0–1
  // fractions of width/height). Null = plain, unpinned comment.
  anchorX    Float?
  anchorY    Float?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([artifactId])
  @@map("comments")
}

// Durable notification center. Every user-facing system event worth
// surfacing (model-trial failures, run outcomes, approvals) lands here once:
// the UI toasts it briefly, then it lives behind the bell icon with an
// unread count until the user opens/clears it.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("info") // info | success | error | warning
  title     String
  message   String   @db.Text
  source    String   @default("system") // models | runs | approvals | system
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// Provider uptime telemetry — one row per provider attempt (success or
// error) so the Settings → Provider & Cost tab can show a 7-day reliability
// view per provider/model. Written best-effort by /api/chat's provider
// ladder and the server executor's failover loop; a telemetry failure must
// never affect the request that produced it.
model ProviderEvent {
  id        String   @id @default(cuid())
  userId    String
  lane      String   // "chat" | "server_run"
  provider  String   // registry/config provider name ("nvidia", "openrouter", …)
  model     String   // model id the attempt targeted
  outcome   String   // "ok" | "error"
  errorKind String?  // rate_limit | auth | server | network | bad_request | error
  httpStatus Int?
  latencyMs Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@map("provider_events")
}

// Sync hub mailbox: entries peers have pushed, delivered cursor-based to
// the user's OTHER machines. Ids are client-generated (monotonic per peer).
model SyncEvent {
  id        String   @id
  userId    String
  machineId String
  payload   String   @db.Text
  at        DateTime @default(now())

  @@index([userId, id])
  @@map("sync_events")
}

model ApiKeyPool {
  id          String    @id @default(cuid())
  provider    String // nvidia | openrouter
  apiKey      String // AES-256-GCM encrypted
  model       String // minimaxai/minimax-m3 | meta/llama-3.1-8b-instruct
  usageToday  Int       @default(0)
  dailyLimit  Int       @default(1000)
  lastResetAt DateTime  @default(now())
  isActive    Boolean   @default(true)
  priority    Int       @default(0)
  failures    Int       @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, isActive])
  @@map("api_key_pool")
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  model     String
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  latencyMs Int      @default(0)
  success   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("usage_logs")
}

model UserQuota {
  id            String   @id @default(cuid())
  userId        String   @unique
  requestsToday Int      @default(0)
  dailyLimit    Int      @default(1000)
  lastResetAt   DateTime @default(now())
  tier          String   @default("free")

  @@map("user_quotas")
}

model UserApiKey {
  id         String   @id @default(cuid())
  userId     String
  provider   String // registry id: nvidia | openrouter | groq | anthropic | gemini | ...
  apiKey     String // AES-256-GCM encrypted
  model      String // minimaxai/minimax-m3 | meta/llama-3.1-8b-instruct
  isActive   Boolean  @default(true)
  usageToday Int      @default(0)
  createdAt  DateTime @default(now())

  // Display name chosen by the user (optional).
  label          String?
  // Set when the add-flow live test succeeded.
  verified       Boolean?
  lastVerifiedAt DateTime?
  // Normalized model listing from the provider (provider-models.ts engine).
  modelsCache    Json?
  modelsFetchedAt DateTime?

  @@index([userId])
  @@map("user_api_keys")
}

// === Rate Limiting & Circuit Breaker ===

model RateLimitWindow {
  key         String   @db.Text
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime

  @@id([key, windowStart])
  @@index([expiresAt])
  @@map("rate_limit_windows")
}

model CircuitBreakerState {
  provider    String    @id
  failures    Int       @default(0)
  isOpen      Boolean   @default(false)
  openUntil   DateTime?
  lastFailure DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("circuit_breaker_states")
}

// === Vector Memory & SONA Persistence ===

model VectorMemoryEntry {
  id        String   @id @default(cuid())
  type      String // code_change | conversation | pattern | error | convention
  content   String   @db.Text
  embedding Json // number[] (128-dim)
  filePath  String?
  tool      String?
  success   Boolean?
  tags      String[]
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@map("vector_memory_entries")
}

model SonaPattern {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  embedding   Json // number[] (128-dim)
  steps       String[] // tool sequence
  successRate Float    @default(1.0)
  useCount    Int      @default(1)
  avgDuration Int      @default(0)
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tags])
  @@map("sona_patterns")
}

model SonaTrajectory {
  id            String   @id @default(cuid())
  task          String   @db.Text
  embedding     Json // number[] (128-dim)
  outcome       String // success | partial | failure
  totalDuration Int      @default(0)
  totalTokens   Int      @default(0)
  filesChanged  String[]
  toolsUsed     String[]
  tags          String[]
  steps         Json // TrajectoryStep[]
  createdAt     DateTime @default(now())

  @@index([outcome])
  @@index([createdAt])
  @@map("sona_trajectories")
}

// === Workspace & Multi-User Support ===

model Workspace {
  id        String            @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  members   WorkspaceMember[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("member") // owner | admin | member
  joinedAt    DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

// Persistent run ledger — the agent's cross-restart memory of what happened
// to every task: verification-lane verdicts, token-meter economics, and the
// failure context (what broke, how often, which files) so the Failure
// Doctrine teaches from real history after any restart, not just a session.
model TaskRun {
  id                String   @id @default(cuid())
  workspaceKey      String // machineId:workspace — scope for learning
  task              String
  mode              String
  finalStatus       String // done | error | aborted
  typecheckLane     String   @default("skipped") // pass | fail | skipped
  browserLane       String   @default("skipped")
  swarmLane         String   @default("skipped")
  modelCalls        Int      @default(0)
  fullCalls         Int      @default(0)
  compactCalls      Int      @default(0)
  systemTokensSpent Int      @default(0)
  systemTokensFull  Int      @default(0)
  tokensSaved       Int      @default(0)
  savedPct          Int      @default(0)
  durationMs        Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([workspaceKey, createdAt])
  @@index([workspaceKey, finalStatus])
  @@map("task_runs")
}

// A distinct failure signature per workspace/lane. Recurrence raises `count`
// (the anti-loop signal); a passing lane resolves it so stale wounds don't
// teach forever.
model TaskFailure {
  id           String    @id @default(cuid())
  workspaceKey String
  kind         String // typecheck | browser | command | review
  detail       String // normalized error evidence
  detailHash   String // stable identity of `detail` (unique per workspace/kind)
  files        Json?
  count        Int       @default(1)
  firstSeenAt  DateTime  @default(now())
  lastSeenAt   DateTime  @updatedAt
  resolvedAt   DateTime?

  @@unique([workspaceKey, kind, detailHash])
  @@index([workspaceKey, lastSeenAt])
  @@map("task_failures")
}

// Durable workspace learnings — the successor to the removed sona/vector-memory
// façade. Everything stored here is EVIDENCE-backed (derived from a completed,
// verified task) and is retrieved into the agent's prompt for later tasks in
// the same workspace. Recurrence bumps `count`; entries decay via lastSeenAt
// scoring, never deleted silently (user can forget via the UI/API).
model WorkspaceMemory {
  id           String   @id @default(cuid())
  workspaceKey String // machineId:workspace — same scope as TaskRun
  kind         String // pattern | stack | decision | pitfall
  content      String   @db.Text // one learning, self-contained
  contentHash  String // stable identity of `content` (unique per workspace/kind)
  evidence     Json? // files, lanes, task text that produced it
  files        Json? // file paths this learning relates to (retrieval key)
  embedding    Json? // MiniLM 384-dim vector (Float32Array → number[]); null until first embed pass
  count        Int      @default(1) // times re-observed
  firstSeenAt  DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@unique([workspaceKey, kind, contentHash])
  @@index([workspaceKey, lastSeenAt])
  @@map("workspace_memories")
}

// Projects sidebar roster: the workspace folders a user has opened, synced
// across their machines (folder NAMES — handles/paths stay device-bound, so
// a synced-but-unbound project renders as a ghost row until the folder is
// located locally). One row per (user, name); machines merge by lastOpenedAt.
model ProjectRecord {
  id            String   @id @default(cuid())
  userId        String
  name          String // folder name — the join key to Conversation.workspaceName
  displayName   String? // user-set alias (rename), falls back to name
  lastOpenedAt  DateTime @default(now()) // newest wins when machines merge
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, lastOpenedAt])
  @@map("project_records")
}

// ── MCP connectors ─────────────────────────────────────────────────────────

// A user's connected MCP server (one row per user per catalog entry).
// Config is stored in the Claude Code wire shape (command/args/env) so it can
// be handed straight to the executor's stdio client; env secrets (API tokens
// etc.) are encrypted at rest with the same AES-256-GCM key used for BYOK.
model McpServerConfig {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId    String // catalog id (slug), e.g. "supabase" — not unique per user
  label       String? // user-editable alias
  command     String
  args        Json     @default("[]")
  env         Json     @default("{}") // values may be ciphertext — never sent raw to the FE
  enabled     Boolean  @default(true)
  lastTestAt  DateTime?
  lastTestOk  Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, serverId])
  @@index([userId, enabled])
  @@map("mcp_server_configs")
}

// OAuth-authorized connection to a REMOTE MCP server (spec Phase 2). One row
// per (user, catalog id) — the stdio/token path stays in McpServerConfig;
// this table is the OAuth path. Tokens live ONLY here as AES-256-GCM
// ciphertext (same key as BYOK); never returned raw to the renderer.
model McpConnection {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId         String // catalog id (slug), e.g. "github"
  transport        String    @default("streamable-http") // streamable-http | sse
  url              String // MCP endpoint the transport connects to
  status           String    @default("connected") // connected | connected_no_tools | needs_reauth | disconnected
  issuer           String? // authorization-server issuer the tokens are bound to (SEP-2352)
  clientId         String? // registered client_id (plaintext — not a secret)
  clientSecret     String? // AES-256-GCM ciphertext (DCR clients that got a secret)
  tokensCiphertext String?   @db.Text // AES-256-GCM JSON of StoredOAuthTokens — never plaintext
  tokenType        String? // display metadata only (Bearer / DPoP)
  scope            String? // granted scopes (display + step-up checks)
  expiresAt       DateTime? // access-token expiry (null = unknown/no expiry)
  // C6 SDK-lane twin of the browser lane's orplex.mcp.prefs.v1 toggle: the
  // same auto-approve-read-only setting, Prisma-backed (tool-snapshot.ts).
  autoApproveReadOnly Boolean @default(false)
  version          Int       @default(1) // optimistic lock for token/client writes
  lastTestAt       DateTime?
  lastTestOk       Boolean?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, serverId])
  @@index([userId, status])
  @@map("mcp_connections")
}

// One in-flight OAuth authorization: created at connect, single-use at
// complete. Holds the state param, PKCE verifier, and exact redirect_uri so
// the callback leg proves the exchange belongs to this browser round-trip
// (one-time server-stored state doubles as the CSRF defense — there is no
// proxy CSRF layer). codeVerifier/authorizationUrl never leave the server.
model McpOAuthPending {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId         String
  state            String    @unique // OAuth state param — single-use correlation key
  codeVerifier     String? // PKCE code_verifier (server-side only)
  redirectUrl      String // exact redirect_uri registered with the AS
  authorizationUrl String?   @db.Text // where the browser was sent (read once by the UI)
  issuer           String? // resolved authorization-server issuer (discovery result)
  discoveryState   Json? // OAuthDiscoveryState (SEP-2352) — skips re-discovery on the callback leg
  status           String    @default("pending") // pending | consumed | failed
  consumedAt       DateTime?
  expiresAt        DateTime // TTL (10 minutes)
  version          Int       @default(1) // optimistic lock on claim/finish
  failureReason    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, serverId, status])
  @@index([expiresAt])
  @@map("mcp_oauth_pendings")
}

// One row per discovered tool — the persistence half of the Phase 5
// discovery pipeline. The hub writes after every tools/list (tool-snapshot
// diff → McpConnection status connected/connected_no_tools); the AI loops
// read it back through tool-builder (C5). annotations carries ToolAnnotations
// (readOnly/destructive hints) so the server lane can risk-tier without a
// localStorage registry (C6).
model McpTool {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverId    String // catalog slug / remote id — same key as McpConnection
  name        String // unqualified tool name from tools/list
  description String   @default("")
  inputSchema Json? // full JSON Schema — feeds model defs
  annotations Json? // ToolAnnotations — C6 risk hints, server-side
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([userId, serverId, name])
  @@index([userId, serverId])
  @@map("mcp_tools")
}
